# Copy to .env.local for local development. On Vercel, set these in the project's
# Environment Variables (Neon and Resend from the Marketplace add theirs automatically).

# Neon Postgres. Leave empty locally to use the embedded database in .data/pglite.
DATABASE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL, e.g. https://your-app.vercel.app. Required in production;
# locally it can stay empty and is taken from each request.
BETTER_AUTH_URL=

# Resend. Leave empty locally to print emails to the server console instead.
RESEND_API_KEY=
# A sender on your verified Resend domain, e.g. "Patient Control <no-reply@your-domain.com>"
EMAIL_FROM=

# Encrypts sensitive patient fields (ID number, medical background, notes).
# Generate with: openssl rand -base64 32. Keep it safe: without it the data can't be read.
DATA_ENCRYPTION_KEY=

# Protects the reminders job (/api/cron/reminders). Vercel sends it with every
# scheduled run. Generate with: openssl rand -base64 32
CRON_SECRET=
